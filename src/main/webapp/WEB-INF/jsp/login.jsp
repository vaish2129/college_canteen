<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Sign in | CampusBite"/><%@ include file="header.jspf" %><section class="auth-layout"><div class="auth-aside"><span class="eyebrow">A BETTER BREAK STARTS HERE</span><h1>Welcome back<br>to your <em>happy place.</em></h1><p>Good food, simple ordering, and more time to enjoy your day.</p><div class="auth-illustration">🥪<span>✦</span></div></div><div class="auth-card"><span class="eyebrow">SIGN IN</span><h2>Good to see you.</h2><p class="muted">Enter your account details to continue.</p><c:if test="${param.registered eq '1'}"><div class="alert alert-success">Account created. You can sign in now.</div></c:if><c:if test="${not empty error}"><div class="alert alert-error"><c:out value="${error}"/></div></c:if><form method="post" action="${pageContext.request.contextPath}/login" class="form-stack"><label>Username<input name="username" autocomplete="username" required autofocus></label><label>Password<input type="password" name="password" autocomplete="current-password" required></label><button class="button button-wide" type="submit">Sign in <span>→</span></button></form><p class="auth-switch">New to CampusBite? <a href="${pageContext.request.contextPath}/register">Create an account</a></p><p class="demo-hint">Demo admin: <b>admin</b> / <b>admin123</b></p></div></section><%@ include file="footer.jspf" %>
