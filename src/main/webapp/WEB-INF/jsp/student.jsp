<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="pageTitle" value="Your dashboard | CampusBite"/><%@ include file="header.jspf" %><section class="section-block compact-section"><div class="section-heading"><div><span class="eyebrow">YOUR CAMPUS BITEBOARD</span><h2>Hey, <c:out value="${sessionScope.user.fullName}"/><span class="heading-dot">.</span></h2><p class="muted">A little dashboard for your next delicious break.</p></div><a class="button" href="${pageContext.request.contextPath}/menu">Order a bite <span>→</span></a></div><div class="metric-grid student-metrics"><article class="metric-card metric-primary"><span>YOUR ORDERS</span><strong>${orderCount}</strong><small>Every tasty moment</small><span class="metric-icon">🧾</span></article><article class="metric-card"><span>IN PROGRESS</span><strong>${activeOrders}</strong><small>Orders being prepared</small><span class="metric-icon">◷</span></article><article class="metric-card"><span>COMPLETED SPEND</span><strong>₹<fmt:formatNumber value="${totalSpent}" minFractionDigits="2"/></strong><small>On fulfilled orders</small><span class="metric-icon">↗</span></article><article class="metric-card"><span>PREP ESTIMATE</span><strong>${prepMinutes} <small>min</small></strong><small>For your active orders</small><span class="metric-icon">♨</span></article></div><section class="panel recent-panel"><div class="panel-heading"><div><span class="eyebrow">BACK FOR ANOTHER?</span><h3>Your recent orders</h3></div><a class="text-link" href="${pageContext.request.contextPath}/orders">See all orders →</a></div><c:choose><c:when test="${empty orders}"><div class="inline-empty">Your order history will show up here once you've tried something delicious. <a class="text-link" href="${pageContext.request.contextPath}/menu">Explore today's menu →</a></div></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>Order</th><th>Items</th><th>Placed</th><th>Total</th><th>Status</th></tr></thead><tbody><c:forEach items="${orders}" var="order"><tr><td><b><c:out value="${order.orderId}"/></b></td><td><c:forEach items="${order.items}" var="item" varStatus="loop"><c:if test="${loop.index gt 0}">, </c:if><c:out value="${item.quantity}"/>× <c:out value="${item.foodName}"/></c:forEach></td><td><c:out value="${order.createdAt}"/></td><td>₹<fmt:formatNumber value="${order.totalAmount}" minFractionDigits="2"/></td><td><span class="status-pill status-${order.status.toLowerCase()}">${order.status}</span></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></section></section><%@ include file="footer.jspf" %>
