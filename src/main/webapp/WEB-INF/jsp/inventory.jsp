<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="pageTitle" value="Inventory | CampusBite"/><%@ include file="header.jspf" %><section class="section-block compact-section"><div class="section-heading"><div><span class="eyebrow">FRESHNESS, IN CHECK</span><h2>Menu & inventory<span class="heading-dot">.</span></h2><p class="muted">Manage availability, pricing, and today's stock.</p></div><a class="button button-outline" href="${pageContext.request.contextPath}/admin">← Dashboard</a></div><div class="inventory-layout"><section class="panel add-panel"><span class="eyebrow">ADD SOMETHING DELICIOUS</span><h3>New menu item</h3><form method="post" action="${pageContext.request.contextPath}/inventory" class="form-stack"><input type="hidden" name="action" value="add"><label>Item name<input name="name" maxlength="200" required></label><div class="form-row"><label>Category<input name="category" placeholder="Snacks, Drinks..." required></label><label>Price (₹)<input type="number" name="price" min="0" step="0.01" required></label></div><div class="form-row"><label>Opening stock<input type="number" name="stockQuantity" min="0" value="20" required></label><label>Prep time (min)<input type="number" name="preparationTimeMinutes" min="1" value="10" required></label></div><label>Image URL <small>(optional)</small><input type="url" name="imageUrl" placeholder="https://…"></label><label>Description<textarea name="description" rows="3" maxlength="1000"></textarea></label><label class="checkbox-label"><input type="checkbox" name="available" checked> Available to order</label><button class="button button-wide" type="submit">Add menu item <span>+</span></button></form></section><section class="panel inventory-panel"><div class="panel-heading"><div><span class="eyebrow">WHAT'S ON THE COUNTER</span><h3>Current stock</h3></div><span class="count-tag">${foodItems.size()} items</span></div><c:choose><c:when test="${empty foodItems}"><div class="inline-empty">Add your first item using the form.</div></c:when><c:otherwise><div class="inventory-list"><c:forEach items="${foodItems}" var="food"><details class="inventory-item"><summary><div><strong><c:out value="${food.name}"/></strong><small><c:out value="${food.category}"/></small></div><span class="stock-badge ${food.stockQuantity lt 5 ? 'low' : 'ok'}">${food.stockQuantity} units</span><span class="inventory-price">₹<fmt:formatNumber value="${food.price}" minFractionDigits="2"/></span><span class="details-chevron">⌄</span></summary><form method="post" action="${pageContext.request.contextPath}/inventory" class="inventory-edit"><input type="hidden" name="action" value="update"><input type="hidden" name="id" value="${food.id}"><label>Name<input name="name" value="<c:out value='${food.name}'/>" required></label><div class="form-row"><label>Category<input name="category" value="<c:out value='${food.category}'/>" required></label><label>Price<input type="number" name="price" min="0" step="0.01" value="${food.price}" required></label></div><div class="form-row"><label>Stock<input type="number" name="stockQuantity" min="0" value="${food.stockQuantity}" required></label><label>Prep time<input type="number" name="preparationTimeMinutes" min="1" value="${food.preparationTimeMinutes}" required></label></div><label>Image URL<input type="url" name="imageUrl" value="<c:out value='${food.imageUrl}'/>" ></label><label>Description<textarea name="description" rows="2"><c:out value="${food.description}"/></textarea></label><label class="checkbox-label"><input type="checkbox" name="available" ${food.available ? 'checked' : ''}> Available to order</label><div class="form-actions"><button class="button button-small" type="submit">Save changes</button></div></form><form method="post" action="${pageContext.request.contextPath}/inventory" class="delete-item-form"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${food.id}"><button class="text-danger" type="submit" data-confirm="Delete this menu item? Existing order history will remain.">Delete item</button></form></details></c:forEach></div></c:otherwise></c:choose></section></div></section><%@ include file="footer.jspf" %>
