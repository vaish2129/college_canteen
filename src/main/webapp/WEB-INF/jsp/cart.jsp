<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="pageTitle" value="Your cart | CampusBite"/><%@ include file="header.jspf" %><section class="section-block compact-section"><div class="section-heading"><div><span class="eyebrow">ONE LAST LOOK</span><h2>Your cart<span class="heading-dot">.</span></h2></div><a class="text-link" href="${pageContext.request.contextPath}/menu">← Back to menu</a></div><c:choose><c:when test="${cart.empty}"><div class="empty-state"><span>🛍️</span><h3>Your cart is taking a break</h3><p>Browse today's menu and add a favorite.</p><a class="button" href="${pageContext.request.contextPath}/menu">Explore menu</a></div></c:when><c:otherwise><div class="cart-layout"><div class="cart-list"><c:forEach items="${cart.items}" var="item"><article class="cart-row"><div class="cart-item-emoji">🍽️</div><div class="cart-item-main"><h3><c:out value="${item.foodName}"/></h3><span>₹<fmt:formatNumber value="${item.unitPrice}" minFractionDigits="2"/></span></div><form class="quantity-form" method="post" action="${pageContext.request.contextPath}/cart"><input type="hidden" name="action" value="update"><input type="hidden" name="foodId" value="${item.foodId}"><label class="sr-only" for="qty-${item.foodId}">Quantity</label><input id="qty-${item.foodId}" type="number" min="1" name="quantity" value="${item.quantity}"><button class="button button-small button-outline" type="submit">Update</button></form><strong class="line-total">₹<fmt:formatNumber value="${item.lineTotal}" minFractionDigits="2"/></strong><form method="post" action="${pageContext.request.contextPath}/cart"><input type="hidden" name="action" value="remove"><input type="hidden" name="foodId" value="${item.foodId}"><button class="remove-button" type="submit" aria-label="Remove item">×</button></form></article></c:forEach></div><aside class="order-summary"><span class="eyebrow">ORDER SUMMARY</span><h3>Ready when you are.</h3><div class="summary-line"><span>Items (${cart.itemCount})</span><span>₹<fmt:formatNumber value="${cart.total}" minFractionDigits="2"/></span></div><div class="summary-line"><span>Pickup</span><span class="free-tag">At the canteen</span></div><div class="summary-total"><span>Total</span><strong>₹<fmt:formatNumber value="${cart.total}" minFractionDigits="2"/></strong></div><form method="post" action="${pageContext.request.contextPath}/orders" class="form-stack"><input type="hidden" name="action" value="checkout"><label>Payment at checkout<select name="paymentMethod"><option value="CASH">Cash on pickup</option><option value="DEMO_ONLINE">Demo online payment (no charge)</option></select></label><small>Online payment is a simulation for demonstration only. No card details are collected.</small><button class="button button-wide" type="submit">Place order <span>→</span></button></form></aside></div></c:otherwise></c:choose></section><%@ include file="footer.jspf" %>
