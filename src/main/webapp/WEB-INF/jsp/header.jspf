<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><c:out value="${pageTitle}" default="CampusBite | College Canteen"/></title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/app.css"><script defer src="${pageContext.request.contextPath}/js/app.js"></script></head><body>
<header class="site-header"><a class="brand" href="${pageContext.request.contextPath}/menu"><span class="brand-mark">CB</span><span>Campus<span class="brand-accent">Bite</span><small>SMART CANTEEN</small></span></a><button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">☰</button><nav class="main-nav"><a href="${pageContext.request.contextPath}/menu">Menu</a><c:if test="${sessionScope.user.role eq 'STUDENT'}"><a href="${pageContext.request.contextPath}/student">Dashboard</a></c:if><c:if test="${not empty sessionScope.user}"><a href="${pageContext.request.contextPath}/orders"><c:choose><c:when test="${sessionScope.user.role eq 'ADMIN'}">Orders</c:when><c:otherwise>My orders</c:otherwise></c:choose></a></c:if><c:if test="${sessionScope.user.role eq 'ADMIN'}"><a href="${pageContext.request.contextPath}/admin">Dashboard</a><a href="${pageContext.request.contextPath}/inventory">Inventory</a><a href="${pageContext.request.contextPath}/analytics">Analytics</a></c:if><c:if test="${sessionScope.user.role ne 'ADMIN'}"><a href="${pageContext.request.contextPath}/cart">Cart <span class="cart-count"><c:out value="${sessionScope.cart.itemCount}" default="0"/></span></a></c:if></nav><div class="account-nav"><c:choose><c:when test="${not empty sessionScope.user}"><span class="welcome-user">Hi, <c:out value="${sessionScope.user.fullName}"/></span><a class="button button-small button-outline" href="${pageContext.request.contextPath}/logout">Sign out</a></c:when><c:otherwise><a href="${pageContext.request.contextPath}/login">Sign in</a><a class="button button-small" href="${pageContext.request.contextPath}/register">Join now</a></c:otherwise></c:choose></div></header>
<main class="page-shell"><c:if test="${not empty sessionScope.flashSuccess}"><div class="alert alert-success"><c:out value="${sessionScope.flashSuccess}"/><% session.removeAttribute("flashSuccess"); %></div></c:if><c:if test="${not empty sessionScope.flashError}"><div class="alert alert-error"><c:out value="${sessionScope.flashError}"/><% session.removeAttribute("flashError"); %></div></c:if>
