<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="pageTitle" value="Sales analytics | CampusBite"/><%@ include file="header.jspf" %><section class="section-block compact-section"><div class="section-heading"><div><span class="eyebrow">NUMBERS WITH A SIDE OF FRIES</span><h2>Sales analytics<span class="heading-dot">.</span></h2><p class="muted">A snapshot of what your campus is loving.</p></div><a class="button button-outline" href="${pageContext.request.contextPath}/admin">← Dashboard</a></div><div class="metric-grid"><article class="metric-card metric-primary"><span>COMPLETED ORDERS</span><strong>${analytics.totalOrders}</strong><small>All-time fulfilled orders</small><span class="metric-icon">🧾</span></article><article class="metric-card"><span>TOTAL REVENUE</span><strong>₹<fmt:formatNumber value="${analytics.totalRevenue}" minFractionDigits="2"/></strong><small>Completed orders</small><span class="metric-icon">↗</span></article><article class="metric-card"><span>AVERAGE ORDER VALUE</span><strong>₹<fmt:formatNumber value="${analytics.averageOrderValue}" minFractionDigits="2"/></strong><small>Across fulfilled orders</small><span class="metric-icon">◉</span></article></div><div class="analytics-grid"><section class="panel chart-panel"><div class="panel-heading"><div><span class="eyebrow">LAST 7 DAYS</span><h3>Daily sales</h3></div><span class="chart-legend"><i></i>Revenue</span></div><div id="salesChart" class="sales-chart" role="img" aria-label="Revenue chart for the last seven days"></div><c:if test="${empty analytics.dailySales}"><p class="muted chart-empty">No completed sales in the last seven days yet.</p></c:if></section><section class="panel"><div class="panel-heading"><div><span class="eyebrow">THE CROWD PLEASERS</span><h3>Top sellers</h3></div></div><c:choose><c:when test="${empty analytics.popularItems}"><div class="inline-empty">Completed orders will reveal your best sellers.</div></c:when><c:otherwise><ol class="popular-list analytics-popular"><c:forEach items="${analytics.popularItems}" var="item" varStatus="loop"><li><span class="rank-dot">0${loop.count}</span><span><c:out value="${item.name}"/></span><small>${item.count} sold</small></li></c:forEach></ol></c:otherwise></c:choose></section></div></section><script>window.canteenSales=[<c:forEach items="${analytics.dailySales}" var="day" varStatus="loop">{"date":"<c:out value='${day.date}'/>","revenue":<c:out value="${day.revenue}"/>}<c:if test="${!loop.last}">,</c:if></c:forEach>];</script><%@ include file="footer.jspf" %>
