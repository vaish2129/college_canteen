<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Create account | CampusBite"/><%@ include file="header.jspf" %><section class="auth-layout register-layout"><div class="auth-aside"><span class="eyebrow">CAMPUS BITES, BETTER</span><h1>Make your<br>break a little<br><em>brighter.</em></h1><p>Join CampusBite and order your favorites before the bell.</p><div class="auth-illustration">🥗<span>✦</span></div></div><div class="auth-card"><span class="eyebrow">STUDENT ACCOUNT</span><h2>Let's get you started.</h2><p class="muted">A few details and you're ready to order.</p><c:if test="${not empty error}"><div class="alert alert-error"><c:out value="${error}"/></div></c:if><form method="post" action="${pageContext.request.contextPath}/register" class="form-stack"><label>Full name<input name="fullName" autocomplete="name" required></label><div class="form-row"><label>Username<input name="username" minlength="3" autocomplete="username" required></label><label>Email<input type="email" name="email" autocomplete="email" required></label></div><label>Password<input type="password" name="password" minlength="8" autocomplete="new-password" required><small>At least 8 characters.</small></label><div class="form-row"><label>Student ID<input name="studentId"></label><label>Department<input name="department"></label></div><div class="form-row"><label>Year<input name="year" placeholder="e.g. 2nd year"></label><label>Phone<input type="tel" name="phone" autocomplete="tel"></label></div><button class="button button-wide" type="submit">Create account <span>→</span></button></form><p class="auth-switch">Already registered? <a href="${pageContext.request.contextPath}/login">Sign in</a></p></div></section><%@ include file="footer.jspf" %>
