<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="pageTitle" value="Fresh picks | CampusBite"/><%@ include file="header.jspf" %>
<section class="hero"><div class="hero-copy"><span class="eyebrow">YOUR CAMPUS, YOUR CANTEEN</span><h1>Good food for<br><em>great minds.</em></h1><p>Order ahead, skip the queue, and make every break a good one.</p><div class="hero-actions"><a class="button" href="#menu">Explore today's menu <span>↘</span></a><c:if test="${empty sessionScope.user}"><a class="text-link" href="${pageContext.request.contextPath}/register">Create your student account</a></c:if></div><div class="hero-note"><span class="live-dot"></span> Freshly prepared · Easy pickup · Cash or demo checkout</div></div><div class="hero-art"><div class="hero-orbit"></div><div class="hero-food">🍱</div><div class="floating-tag tag-one">✦ Made fresh daily</div><div class="floating-tag tag-two">🥗 Balanced bites</div><div class="hero-stamp">TASTY<br>BREAKS<br><b>START HERE</b></div></div><div class="hero-index">01 <span>—</span> 03</div></section>
<section id="menu" class="section-block"><div class="section-heading"><div><span class="eyebrow">MADE FOR YOUR BREAK</span><h2>Today's menu<span class="heading-dot">.</span></h2></div><label class="search-box"><span>⌕</span><input id="menuSearch" type="search" placeholder="Find your favorite" aria-label="Search menu"></label></div><div class="filter-row" role="group" aria-label="Filter by category"><button class="filter-chip active" data-category="all">All items</button><c:forEach items="${categories}" var="category"><button class="filter-chip" data-category="<c:out value='${category}'/>"><c:out value="${category}"/></button></c:forEach></div>
<div class="food-grid"><c:forEach items="${foods}" var="food"><article class="food-card" data-category="<c:out value='${food.category}'/>" data-search="<c:out value='${food.name} ${food.category}'/>"><div class="food-image"><c:choose><c:when test="${not empty food.imageUrl}"><img src="<c:out value='${food.imageUrl}'/>" alt="<c:out value='${food.name}'/>" loading="lazy"></c:when><c:otherwise><div class="food-emoji">🍽️</div></c:otherwise></c:choose><span class="category-pill"><c:out value="${food.category}"/></span><span class="prep-pill">◷ ${food.preparationTimeMinutes} min</span></div><div class="food-info"><h3><c:out value="${food.name}"/></h3><p><c:out value="${food.description}" default="Freshly made and ready for your break."/></p><div class="food-buy"><strong>₹<fmt:formatNumber value="${food.price}" minFractionDigits="2" maxFractionDigits="2"/></strong><c:choose><c:when test="${not empty sessionScope.user and sessionScope.user.role ne 'ADMIN'}"><form method="post" action="${pageContext.request.contextPath}/cart"><input type="hidden" name="action" value="add"><input type="hidden" name="foodId" value="${food.id}"><input type="hidden" name="quantity" value="1"><button class="add-button" type="submit" aria-label="Add <c:out value='${food.name}'/> to cart">+</button></form></c:when><c:when test="${empty sessionScope.user}"><a class="add-button" href="${pageContext.request.contextPath}/login" aria-label="Sign in to order">+</a></c:when><c:otherwise><span class="stock-note">${food.stockQuantity} in stock</span></c:otherwise></c:choose></div></div></article></c:forEach><c:if test="${empty foods}"><div class="empty-state"><span>🍽️</span><h3>Menu coming right up</h3><p>There are no available items just now. Check back soon.</p></div></c:if></div></section>
<section class="info-strip"><div><span>01</span><h3>Pick your favorites</h3><p>Explore a menu made for campus life.</p></div><div><span>02</span><h3>Order in a few taps</h3><p>Customize your cart and choose how to pay.</p></div><div><span>03</span><h3>Grab & get going</h3><p>Track progress and collect at the counter.</p></div></section><%@ include file="footer.jspf" %>
