<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="pageTitle" value="Canteen dashboard | CampusBite"/><%@ include file="header.jspf" %><section class="section-block compact-section"><div class="section-heading"><div><span class="eyebrow">THE DAILY SPECIAL</span><h2>Good morning, <c:out value="${sessionScope.user.fullName}"/><span class="heading-dot">.</span></h2><p class="muted">Here's what's happening at your canteen today.</p></div><a class="button" href="${pageContext.request.contextPath}/inventory">Manage menu <span>→</span></a></div><div class="metric-grid"><article class="metric-card metric-primary"><span>COMPLETED ORDERS</span><strong><c:out value="${analytics.totalOrders}" default="0"/></strong><small>All-time fulfilled orders</small><span class="metric-icon">🧾</span></article><article class="metric-card"><span>TOTAL SALES</span><strong>₹<fmt:formatNumber value="${analytics.totalRevenue}" minFractionDigits="2"/></strong><small>From completed orders</small><span class="metric-icon">↗</span></article><article class="metric-card"><span>AVERAGE ORDER</span><strong>₹<fmt:formatNumber value="${analytics.averageOrderValue}" minFractionDigits="2"/></strong><small>Per completed order</small><span class="metric-icon">◉</span></article><article class="metric-card"><span>LOW STOCK</span><strong>${lowStock.size()}</strong><small>Items need a restock</small><span class="metric-icon">⚑</span></article></div><div class="dashboard-grid"><section class="panel"><div class="panel-heading"><div><span class="eyebrow">NEEDS ATTENTION</span><h3>Low-stock alerts</h3></div><a class="text-link" href="${pageContext.request.contextPath}/inventory">View inventory →</a></div><c:choose><c:when test="${empty lowStock}"><div class="inline-empty">✓ Everything is stocked up.</div></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>Menu item</th><th>Remaining</th><th>Restock at</th></tr></thead><tbody><c:forEach items="${lowStock}" var="item"><tr><td><c:out value="${item.foodName}"/></td><td><span class="stock-badge low">${item.stockQuantity} left</span></td><td>${item.threshold}</td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></section><section class="panel"><div class="panel-heading"><div><span class="eyebrow">CUSTOMER FAVORITES</span><h3>Top sellers</h3></div><a class="text-link" href="${pageContext.request.contextPath}/analytics">Analytics →</a></div><c:choose><c:when test="${empty analytics.popularItems}"><div class="inline-empty">Complete orders to see top sellers.</div></c:when><c:otherwise><ol class="popular-list"><c:forEach items="${analytics.popularItems}" var="item"><li><span class="rank-dot">${item.count}</span><span><c:out value="${item.name}"/></span><small>sold</small></li></c:forEach></ol></c:otherwise></c:choose></section></div><section class="panel recent-panel"><div class="panel-heading"><div><span class="eyebrow">KEEP THINGS MOVING</span><h3>Recent orders</h3></div><a class="text-link" href="${pageContext.request.contextPath}/orders">Manage all orders →</a></div><c:choose><c:when test="${empty orders}"><div class="inline-empty">No orders yet. Your next busy lunch is just around the corner.</div></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>Order</th><th>Student</th><th>Placed</th><th>Total</th><th>Status</th><th>Action</th></tr></thead><tbody><c:forEach items="${orders}" var="order" end="5"><tr><td><b><c:out value="${order.orderId}"/></b></td><td><c:out value="${order.studentName}"/></td><td><c:out value="${order.createdAt}"/></td><td>₹<fmt:formatNumber value="${order.totalAmount}" minFractionDigits="2"/></td><td><span class="status-pill status-${order.status.toLowerCase()}">${order.status}</span></td><td><a href="${pageContext.request.contextPath}/orders">Review →</a></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></section></section><%@ include file="footer.jspf" %>
