<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="pageTitle" value="Orders | CampusBite"/><%@ include file="header.jspf" %><section class="section-block compact-section"><div class="section-heading"><div><span class="eyebrow"><c:choose><c:when test="${sessionScope.user.role eq 'ADMIN'}">CANTEEN OPERATIONS</c:when><c:otherwise>YOUR CAMPUS BITES</c:otherwise></c:choose></span><h2><c:choose><c:when test="${sessionScope.user.role eq 'ADMIN'}">All orders</c:when><c:otherwise>My orders</c:otherwise></c:choose><span class="heading-dot">.</span></h2></div><c:if test="${sessionScope.user.role eq 'ADMIN'}"><a class="button button-outline" href="${pageContext.request.contextPath}/admin">Dashboard</a></c:if></div><c:choose><c:when test="${empty orders}"><div class="empty-state"><span>🧾</span><h3>No orders just yet</h3><p>Once an order is placed, its progress will show up here.</p><a class="button" href="${pageContext.request.contextPath}/menu">Order something tasty</a></div></c:when><c:otherwise><div class="orders-list"><c:forEach items="${orders}" var="order"><article class="order-card"><div class="order-card-head"><div><span class="eyebrow"><c:out value="${order.orderId}"/></span><h3><c:out value="${order.studentName}"/></h3><small><c:out value="${order.createdAt}"/></small></div><span class="status-pill status-${order.status.toLowerCase()}"><c:out value="${order.status}"/></span></div><div class="order-items"><c:forEach items="${order.items}" var="item"><span><b>${item.quantity}×</b> <c:out value="${item.foodName}"/> · ₹<fmt:formatNumber value="${item.price}" minFractionDigits="2"/></span></c:forEach></div><div class="order-card-foot"><div><span class="muted">Payment · <c:out value="${order.paymentMethod}"/></span><strong>Total ₹<fmt:formatNumber value="${order.totalAmount}" minFractionDigits="2"/></strong></div><c:choose><c:when test="${sessionScope.user.role eq 'ADMIN'}"><c:if test="${order.status ne 'CANCELLED' and order.status ne 'COMPLETED'}"><form method="post" action="${pageContext.request.contextPath}/orders" class="status-form"><input type="hidden" name="orderId" value="${order.id}"><select name="status" aria-label="Update order status"><c:forEach items="${['PENDING','ACCEPTED','PREPARING','READY','COMPLETED','CANCELLED']}" var="status"><option value="${status}" ${order.status eq status ? 'selected' : ''}><c:out value="${status}"/></option></c:forEach></select><button class="button button-small" name="action" value="status">Save status</button></form></c:if></c:when><c:when test="${order.status eq 'PENDING' or order.status eq 'ACCEPTED'}"><form method="post" action="${pageContext.request.contextPath}/orders"><input type="hidden" name="orderId" value="${order.id}"><button class="button button-small button-outline" name="action" value="cancel" data-confirm="Cancel this order?">Cancel order</button></form></c:when></c:choose></div></article></c:forEach></div></c:otherwise></c:choose></section><%@ include file="footer.jspf" %>
